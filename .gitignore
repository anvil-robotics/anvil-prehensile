# ---------------------------------------------------------------------------
# Local-only. Everything here is either regenerated by a command in README.md
# or is machine-specific recorder output. Nothing here belongs in the repo.
# ---------------------------------------------------------------------------

# Python build / bytecode
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environment -- 5.3 GB in the source tree. Rebuild with `uv sync`.
.venv/

# Recorder output. tools/record_thumb_sweep.py writes
# recordings/thumb_sweep_<glove>_<side>_<HHMMSS>.{csv,npz} and mkdir()s the
# directory on demand, so this needs no .gitkeep either.
recordings/

# Editor / OS
.DS_Store
*.sw[op]
.idea/
.vscode/

# Claude Code local overrides (shared config would be .claude/settings.json)
.claude/settings.local.json
